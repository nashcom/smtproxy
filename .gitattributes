# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly mark shell scripts as text + executable-safe
*.sh text eol=lf

# Go source
*.go text eol=lf

# Config / data formats
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
*.conf text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Dockerfiles
dockerfile text eol=lf
dockerfile* text eol=lf
Dockerfile text eol=lf
Dockerfile* text eol=lf

# Binary files — never modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.pem binary
*.crt binary
*.key binary
